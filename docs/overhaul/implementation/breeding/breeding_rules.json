    {
      "id": "egg_check_interval",
      "before": "egg roll when day-care step counter & 0xff == 0xff (every 256 steps)",
      "target": "& 0x7f == 0x7f (every 128 steps); compatibility 0/20/50/70 unchanged",
      "symbol": "DAYCARE_EGG_CHECK_INTERVAL",
      "authority": "docs/overhaul/breeding/BREEDING_SPEC.md#10"
    },
    {
      "id": "special_date_bonus",
      "before": "Daycare_GetEggCycleLength: 255 steps per hatch cycle, 230 on 12 special dates",
      "target": "unchanged",
      "normalization": "The 255/230 constant is the hatch-cycle length, not the egg-roll cadence (that is the day-care step counter above). Halving it would stack with the halved hatch_cycles table and make eggs hatch in ~1/4 of vanilla, contradicting spec #11 ('roughly half'). It is therefore left alone; the special-date micro-bonus only shortens hatching and cannot make the egg interval slower than ordinary overhaul breeding.",
      "authority": "docs/overhaul/breeding/BREEDING_IMPLEMENTATION_PLAN.md#9"
    },
