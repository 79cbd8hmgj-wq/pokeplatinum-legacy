    "preflight": "Use repository source map and existing opal cue macros; verify exact vanilla move scripts and which animations already overlap with B2-B8. Reuse pre-existing effect assets before new imports. Confirm the exact target revision and compile base.",
    "asset_policy": "Verified existing Platinum and previously imported Emerald parts first. New donor candidates must be documented by filename, hash, license provenance, conversion method, and in-game resource IDs. No assumed asset paths.",
    "quality": "Animations should be immediately legible, specific to attack, diverse in their effect silhouettes, no more than a minor duration increase; design for repeated viewing, with restrained bright flashes.",
    "guardrails": [
      "No battle-mechanics changes, damage/status/probability changes or move distribution changes",
      "No new script interpreter unless required by evidence",
      "Never apply hit/blocked/status animations before battle outcome is known",
      "Respect target selection in doubles, spread attacks, contests and Substitute",
      "Restore camera/BG palette/OBJ/OAM on successful, miss, blocked, skip, fade, early-exit paths",
      "Test reduced motion and low-flash configurations",
      "Preserve current PR #110 B2-B8 content"
    ],
    "validation": [
      "CI rev0/rev1 build",
      "existing source-gates and cue trace",
      "asset resource/memory counts",
      "coverage report maps each enhanced move to verified animation script",
      "emulator side by side with vanilla for frequent repeated battle turns",
      "doubles, weather, Substitute, Protect, flinches, faint/interrupt",
      "performance measurement on emulator and hardware when available"
    ],
    "definition_of_done": "Only mark moves tested after screenshots/video or emulator QA; source compilation alone is not visual acceptance.",
    "prerequisites": [
      "Confirm main contains merged PR #110 foundation",
      "Inventory every locally available donor repository and archive",
      "Build cross-pool candidate table and scoped recipe before changing animations"
    ]
  },
  "asset_strategy": {
    "policy": "UNIFIED_MULTI_SOURCE_ASSET_DEVELOPMENT",
    "unrestricted_search": "Search every actually available and authorized donor inventory in parallel or one coordinated index, not sequential one-game passes. Explicitly record what was searched and what was unavailable.",
    "candidate_sources": [
      "Platinum native assets",
