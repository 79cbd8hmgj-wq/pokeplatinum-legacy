{
  "schema_version": 1,
  "description": "Platinum visual subsystems (selection targets) and the donor role each source may play, derived from CROSS_GAME_DONOR_MATRIX.md. Authoritative input to the selection pipeline; edit here, never in code.",
  "donor_classes": {
    "direct": "Same Nitro resource contract as Platinum; deterministic or no conversion.",
    "convertible": "Translatable into Platinum resources with adaptation.",
    "control": "Same engine lineage build used to ask whether Platinum changed/removed something; never preferred over Platinum on its own.",
    "technique": "Implementation/presentation pattern only; not directly portable.",
    "reference": "Visual/art direction only.",
    "none": "No Platinum target or matrix relevance; excluded."
  },
  "subsystems": {
    "pokemon_icons": {
      "title": "Pokemon party/box/summary icons",
      "matrix_row": "Pokemon icons",
      "native_baseline": {
        "kind": "res_dir",
        "path": "res/pokemon/<species>/icon.png",
        "shared": "res/pokemon/.shared/pl_poke_icon.pal"
      },
      "target_kind": "species",
      "integration_cost": 2,
      "priority_weight": 2,
      "evidence_provider": "icons",
      "source_roles": {
        "hgss": {
          "class": "direct",
          "format_family": "nitro_indexed_png_32x64",
          "conversion": "none",
          "rationale": "Same 32x64 4bpp indexed contract and shared-palette banks as Platinum."
        },
        "diamond": {
          "class": "control",
          "format_family": "nitro_ncgr_raw",
          "conversion": "trivial",
          "by_asset_type": {
            "source_png": "none"
          },
          "rationale": "DP/Pt lineage control; raw NCGR members need deterministic decode."
        }
      }
    },
    "pokemon_battle_sprites": {
      "title": "Pokemon battle sprites (front/back, gender, special forms)",
      "matrix_row": "Pokemon battle sprites",
      "native_baseline": {
        "kind": "res_dir",
        "path": "res/pokemon/<species>/{male,female}_{front,back}.png"
      },
      "target_kind": "species",
      "integration_cost": 3,
      "priority_weight": 5,
      "evidence_provider": "battle_sprites",
      "source_roles": {
        "hgss": {
          "class": "direct",
          "format_family": "nitro_indexed_png_160x80",
          "conversion": "none",
          "rationale": "Identical 160x80 indexed contract; palette derivation guarded separately."
        },
        "diamond": {
          "class": "control",
          "format_family": "nitro_indexed_png_160x80",
          "conversion": "none",
          "rationale": "DP lineage control."
        }
      }
    },
    "trainer_battle_sprites": {
      "title": "Trainer battle sprites",
      "matrix_row": "Trainer battle sprites",
      "native_baseline": {
        "kind": "narc",
        "path": "res/trainers (pl_trgra)"
      },
      "target_kind": "trainer_class",
      "integration_cost": 3,
      "priority_weight": 3,
      "evidence_provider": "trainer_sprites",
      "source_roles": {
        "diamond": {
          "class": "control",
          "format_family": "nitro_indexed_png",
          "conversion": "none",
          "rationale": "DP lineage control (Platinum class index equals DP class index; see alignment/trainer_classes.json)."
        },
        "hgss": {
          "class": "direct",
          "format_family": "nitro_sprite_set_ncgr_nclr_ncer_nanr",
          "conversion": "trivial",
          "rationale": "HGSS trainer sets use the same 80x80 extended-cell NCGR/NCLR/NCER/NANR model as Platinum's trfgra/trbgra sources; deterministic NARC->PNG+cell/anim JSON decode."
        }
      },
      "human_review_required": true
    },
    "pokemon_animation_reference": {
      "title": "Pokemon animation timing/staging",
      "matrix_row": "Pokemon animation timing",
      "native_baseline": {
        "kind": "src",
        "path": "res/pokemon/<species>/sprite_data.json + battle animation scripts"
      },
      "target_kind": "species",
      "integration_cost": 5,
      "priority_weight": 1,
      "evidence_provider": null,
      "source_roles": {
        "ranger2": {
          "class": "reference",
          "format_family": "ranger_cell_frames",
          "conversion": "not_portable",
          "rationale": "Ranger Pokemon cell animations differ in art/engine; usable only as timing/staging reference."
        }
      }
    },
    "field_npc_player_sprites": {
      "title": "NPC/player field sprites",
      "matrix_row": "NPC/player field sprites",
      "native_baseline": {
        "kind": "res_dir",
        "path": "res/field/ow_sprites"
      },
      "target_kind": "family",
      "integration_cost": 4,
      "priority_weight": 3,
      "evidence_provider": "field_sprites",
      "source_roles": {
        "ranger2": {
          "class": "none",
          "format_family": "ranger_npc_package",
          "conversion": "not_portable",
          "rationale": "Matrix names HGSS/Platinum/Diamond for this row; Ranger art style and packaging are unrelated."
        },
        "hgss": {
          "class": "direct",
          "format_family": "nsbtx_frame_textures_32x32_4bpp",
          "conversion": "trivial",
          "rationale": "HGSS NSBTX frame textures are the same 32x32 4bpp frame sheets Platinum builds from res/graphics/field_sprites PNGs (index data proven identical for aligned sprites); deterministic NSBTX->PNG decode. Alignment is by shared model-slot base name, which is NOT subject identity; non-trivial differences are classified subject_unverified."
        }
      }
    },
